# OS / editor
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# Python
__pycache__/
*.pyc

# Temp
*.log
*.tmp

# Raw build sources (large; re-fetched by build scripts). The built runtime
# data under data/wbw/ IS committed.
data/_sources/

# Бинарные данные сканов — на Cloudflare R2, в репозиторий не коммитим.
# Карты страниц (data/img/<id>/<sura>.json, _about.json) ОСТАЮТСЯ в репо.
data/img/**/*.webp
data/img/**/*.png
data/img/**/*.jpg
# Аудио-тилява (задел; на объектном хранилище) — но аятные тайминги посурных
# чтецов (build_timings.py) лёгкие и лежат в репо
data/audio/*
!data/audio/timings/

# venv для build_timings.py (torch+ctc-forced-aligner; система на py3.14)
.venv-timings/

